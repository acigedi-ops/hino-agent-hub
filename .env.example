# Postgres connection string
DATABASE_URL="postgresql://rhino:rhino@localhost:5432/rhino_hub"
# First owner account, created by `npm run db:seed`
SEED_ADMIN_EMAIL="owner@example.com"
SEED_ADMIN_NAME="Owner"
SEED_ADMIN_PASSWORD="change-me-now"

# Claude API key for the home page assistant. Leave empty to show the chat box switched off.
ANTHROPIC_API_KEY=""

# Optional. A long random key (24+ characters) that lets the assistant sign in as its own owner-level account
# through POST /api/service-login. Leave empty to keep that door closed.
HUB_ADMIN_KEY=""
